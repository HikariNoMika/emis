# Server deployment settings. Copy to .env at the project root and fill in.
# These values are used by docker-compose.server.yml.

# --- PostgreSQL (your EXISTING server, dedicated EMIS role) -----------------
# If PostgreSQL runs on the same server as Docker, use host.docker.internal.
# If it is remote, use that host/IP instead.
DATABASE_URL=postgresql+psycopg2://emis_app:CHANGE_ME@host.docker.internal:5432/emis

# CORS must list the URL users will actually open, e.g. http://example.com:8080
CORS_ORIGINS=http://localhost:8080

# --- Secrets (generate fresh values, e.g. python -c "import secrets; print(secrets.token_hex(32))") ---
SECRET_KEY=CHANGE_ME
JWT_SECRET_KEY=CHANGE_ME

# --- Host ports (only the frontend is published by default) ----------------
FRONTEND_PORT=8080
