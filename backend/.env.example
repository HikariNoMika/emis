# Copy this file to backend/.env and change the secrets.

# --- Security (REQUIRED in production) ---
SECRET_KEY=replace-with-a-long-random-string
JWT_SECRET_KEY=replace-with-a-different-long-random-string
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=30

# --- Database (PostgreSQL + TimescaleDB) ---
DATABASE_URL=postgresql+psycopg2://emis:emis@localhost:5432/emis

# --- Frontend origin(s) allowed to call the API (comma separated) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Uploads ---
UPLOAD_FOLDER=./uploads
MAX_UPLOAD_MB=50

# --- Defaults ---
DEFAULT_TIMEZONE=Asia/Manila
DEFAULT_MEASUREMENT_INTERVAL_SECONDS=900

# --- Celery / Redis ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
RATELIMIT_STORAGE_URI=redis://localhost:6379/1

# --- App mode: development | testing | production ---
APP_ENV=development

# --- First administrator (used by seed.py only) ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@emis.local
ADMIN_PASSWORD=ChangeThisPassword123!
ADMIN_FULL_NAME=System Administrator
